# Copy this file to wordpress/.env and fill in your values.
# wordpress/.env is gitignored — never commit real credentials.

# Your WordPress site's base URL (no trailing slash).
WP_URL=https://your-site.example.com

# A WordPress username with permission to publish posts.
WP_USER=your-wp-username

# An Application Password, NOT your login password.
# Create one under WordPress Admin -> Users -> Profile -> Application Passwords.
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
